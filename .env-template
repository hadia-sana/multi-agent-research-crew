# OpenAI API key (required if LLM_PROVIDER=openai)
# Get your key from: https://platform.openai.com/api-keys
# Or use OpenRouter key: https://openrouter.ai/keys
OPENAI_API_KEY=sk-...

# Anthropic API key (required if LLM_PROVIDER=anthropic)
# Get your key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API key (required if LLM_PROVIDER=gemini)
# Get your free API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=...

# AWS Bedrock credentials (required if LLM_PROVIDER=bedrock)
# Get from AWS IAM: https://console.aws.amazon.com/iam
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# LLM provider: "openai", "anthropic", "gemini", or "bedrock"
LLM_PROVIDER=openai
